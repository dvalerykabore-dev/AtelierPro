# =============================================================================
# Environnement de TEST — chargé par Vitest en priorité sur .env
# =============================================================================
# La suite de tests est conçue pour tourner SANS aucune clé de service externe
# (c'est ainsi qu'elle s'exécute en intégration continue). Dès qu'un vrai
# fournisseur est configuré dans .env, les tests se mettent à faire de vrais
# appels réseau : le test de limite d'inscription dépasse alors son délai de
# 5 s, et pire, la suite pourrait envoyer de vrais emails ou téléverser de
# vrais fichiers.
#
# On neutralise donc les fournisseurs ici. Le code de production bascule
# automatiquement sur ses implémentations en mémoire quand ces valeurs sont
# vides (voir le test `if (!url || !token)` dans src/lib/server/redis.ts).
#
# Ce fichier ne contient AUCUN secret — il n'y a que des valeurs vides.
# =============================================================================

# Limiteur de débit → bascule sur le store en mémoire
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Emails → aucun envoi réel pendant les tests
RESEND_API_KEY=""
EMAIL_FROM=""

# Médias → aucun téléversement réel pendant les tests
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Paiements → aucun appel réel au prestataire pendant les tests
BICTORYS_API_KEY=""
BICTORYS_PRIVATE_KEY=""

# Observabilité → pas de remontée d'erreurs pendant les tests
SENTRY_DSN=""
