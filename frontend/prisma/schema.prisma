generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  customers         Customer[]
  tailoringOrders   TailoringOrder[]
  workshopTasks     WorkshopTask[]
  artisans          Artisan[]
  cashMovements     CashMovement[]
  recurringCharges  RecurringCharge[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]      @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id              String    @id @default(cuid())
  userId          String? // nullable — guest checkout supported
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount          Int // gross amount, smallest unit
  currency        String    @default("XOF") // ISO 4217
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail   String?
  customerPhone   String?
  customerName    String?
  metadata        Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey  String?   @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String   @default("XOF")
  status      String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ---------------------------------------------------------------------------
// Domaine atelier de couture
// ---------------------------------------------------------------------------
// Ajouté par le fork (le starter ne ship que des modèles génériques). `Order`
// reste la commande de PAIEMENT ; `TailoringOrder` est la commande de couture.
//
// Tout est rattaché à `userId` : un compte = un atelier. Le multi-atelier
// passerait par `organizationId`, comme le décrit le CLAUDE.md — non activé ici.

model Customer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  // FEMALE | MALE — détermine la palette de mesures présentée (17 ou 23 champs).
  gender String
  loyal  Boolean @default(false)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurementSets MeasurementSet[]
  tailoringOrders TailoringOrder[]

  // Deux clients d'ateliers différents peuvent porter le même nom ; l'unicité
  // n'a de sens que dans un atelier donné.
  @@unique([userId, name])
  @@index([userId, createdAt])
}

model MeasurementSet {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Palette employée au moment du relevé. Conservée avec le relevé : changer
  // le genre du client plus tard ne doit pas réinterpréter d'anciennes mesures.
  gender String
  // Valeurs indexées par `section::numero` (« Haut::9A »). Un Json plutôt qu'une
  // table par champ : les palettes évoluent avec les habitudes de l'atelier, et
  // une migration à chaque ajout de mesure serait disproportionnée.
  values Json
  notes  String?

  // URL Cloudinary des tissus apportés et du modèle choisi.
  fabricPhotos Json?
  modelPhoto   String?

  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, takenAt])
}

model TailoringOrder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Numéro lisible affiché à l'atelier (« #087 »). Séquentiel PAR atelier :
  // chaque couturier compte ses commandes depuis 1, pas depuis un compteur
  // global partagé avec les autres comptes.
  sequence Int

  garment String // type de tenue
  fabric  String?
  color   String?

  // IN_PROGRESS | FITTING | DELIVERY | LATE | DELIVERED
  status String @default("IN_PROGRESS")

  // Montants en francs CFA — entiers, la devise n'a pas de décimales
  // (invariant du CLAUDE.md : jamais de décimales sur la monnaie).
  priceAmount   Int
  depositAmount Int @default(0)

  // Artisan chargé de la confection. Chaîne libre pour l'instant : l'équipe
  // vit dans les paramètres, pas encore en base.
  assignee String?

  dueDate DateTime?
  notes   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  // Encaissements rattachés à cette commande. `depositAmount` ci-dessus est
  // maintenu égal à leur somme, dans la même transaction que leur écriture :
  // le journal fait foi, le champ n'est qu'un raccourci de lecture pour les
  // écrans qui affichent une commande sans charger ses mouvements.
  cashMovements CashMovement[]

  @@unique([userId, sequence])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([customerId, createdAt])
}

model Artisan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  role String

  // Initiales affichées dans les pastilles, et surtout clé de rapprochement :
  // `TailoringOrder.assignee` et `WorkshopTask.assignee` les stockent. D'où
  // l'unicité par atelier — deux « MK » rendraient les deux ambigus. Le jour où
  // ces colonnes deviendront de vraies clés étrangères, cette contrainte pourra
  // tomber ; jusque-là elle est ce qui garantit la jointure.
  initials String

  // Capacité quotidienne en heures. Un apprenti ne tient pas les 8 h d'un
  // tailleur senior, et le planning doit refléter la vraie disponibilité.
  dailyHours Int @default(8)

  // Un artisan qui quitte l'atelier est désactivé, jamais supprimé : ses
  // commandes et ses tâches passées doivent rester lisibles.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, initials])
  @@index([userId, active])
}

model WorkshopTask {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Initiales de l'artisan, comme sur `TailoringOrder.assignee` : l'équipe vit
  // dans les paramètres, pas encore en base. Le jour où elle y sera, ce champ
  // deviendra une relation — d'où l'index qui l'accompagne déjà.
  assignee String

  // Jour planifié, sans heure. `@db.Date` plutôt qu'un `DateTime` complet :
  // une tâche appartient à une journée d'atelier, pas à un instant. Cela évite
  // aussi qu'un décalage de fuseau ne la fasse glisser d'une case dans la grille.
  day DateTime @db.Date

  // Durée en heures pleines. La journée compte 8 blocs à l'atelier.
  hours Int

  label String

  // DONE | IN_PROGRESS | FITTING | PLANNED | BLOCKED
  status String @default("PLANNED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, day])
  @@index([userId, assignee, day])
}

// ---------------------------------------------------------------------------
// Trésorerie de l'atelier
// ---------------------------------------------------------------------------

/// Journal de caisse — un seul registre pour les deux sens.
///
/// Deux tables (recettes d'un côté, dépenses de l'autre) auraient fini par
/// diverger : la trésorerie est la somme signée des mouvements, elle doit se
/// lire d'une seule requête.
///
/// `occurredAt` est le jour où l'argent a bougé, pas celui de la saisie. C'est
/// toute la différence entre une comptabilité et un historique de frappe : un
/// loyer payé le 5 et noté le 12 pèse sur le solde du 5.
model CashMovement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// IN = recette encaissée · OUT = dépense décaissée
  direction String

  /// Montant en francs CFA — entier, la devise n'a pas de décimales
  /// (invariant du CLAUDE.md : jamais de décimales sur la monnaie).
  amount Int

  /// Jour du mouvement. `@db.Date` : une journée, pas un instant — sans quoi
  /// un paiement du 31 à 23 h basculerait au mois suivant selon le fuseau.
  occurredAt DateTime @db.Date

  /// Poste de dépense. Renseigné sur les sorties, nul sur les entrées : une
  /// recette d'atelier a une commande pour origine, pas une catégorie.
  category String?

  /// ESPECES | MOBILE_MONEY | VIREMENT | CARTE
  method String

  label String
  notes String?

  /// Commande encaissée, pour les entrées. `Cascade` : supprimer une commande
  /// retire ses encaissements, sinon la caisse compterait l'argent d'une vente
  /// qui n'existe plus.
  tailoringOrderId String?
  tailoringOrder   TailoringOrder? @relation(fields: [tailoringOrderId], references: [id], onDelete: Cascade)

  /// Vrai quand la ligne a été reconstituée depuis un acompte antérieur au
  /// journal : sa date est celle de la commande, pas celle de l'encaissement.
  /// L'écran le signale plutôt que de faire passer une reprise pour une saisie.
  backfilled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, direction, occurredAt])
  @@index([tailoringOrderId])
}

/// Charge fixe déclarée — loyer, salaires, abonnement.
///
/// Sert uniquement à la prévision : elle ne crée aucun mouvement toute seule.
/// Une charge automatiquement écrite en caisse ferait apparaître un loyer payé
/// alors qu'il ne l'est pas encore, et le solde deviendrait un mensonge.
model RecurringCharge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label    String
  category String
  amount   Int

  /// Jour d'échéance dans le mois, 1 à 28 — au-delà, le mois de février
  /// n'aurait pas d'échéance certaines années.
  dayOfMonth Int @default(1)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}
